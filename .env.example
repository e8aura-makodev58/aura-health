# Keep true for HTTPS; use the explicit private-IP exception for mixed LAN/HTTPS.
AURA_SECURE_COOKIE=true
# Optional explicit LAN HTTP exception (private IP literals only). Public hosts
# keep Secure cookies. Synthetic demo only; never a patient-auth mechanism.
# AURA_HTTP_DEMO_HOSTS=192.168.80.193
AURA_DEMO_PORT=8017
AURA_DEMO_BIND=0.0.0.0
AURA_MAX_DEMO_SESSIONS=16
# Container memory cap (each private demo session uses roughly 8 MB; 64 sessions fit in 2g).
# AURA_MEM_LIMIT=1g
AURA_DEMO_SESSION_TTL=3600
# Optional Cloudflare overlay. PATH ONLY, no token value.
# AURA_TUNNEL_TOKEN_FILE=/absolute/private/path/aura-tunnel.token
# AURA_CLOUDFLARED_IMAGE=cloudflare/cloudflared@sha256:verified-image-digest
